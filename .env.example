# Postgres 16+. The app connects as a role that is a member of echo_app (see docs/adr/ADR-005).
DATABASE_URL=postgresql://postgres@localhost:5432/echo_dev
# "dev" enables the development sign-in with a SIMULATED second factor (refused on hosted deployments).
# "supabase" uses Supabase Auth (ADR-015): email + password, TOTP second step. Any other value disables sign-in.
AUTH_MODE=dev
# For AUTH_MODE=supabase: project URL and its PUBLISHABLE (anon) key. Never a service-role key.
# SUPABASE_URL=https://<project_ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# At least 32 random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000
# Media originals. Local disk is for development only and is refused on hosted deployments.
STORAGE_BACKEND=local
STORAGE_DIR=.data/blobs
# Hosted: STORAGE_BACKEND=s3 with Supabase Storage's S3 protocol (ADR-014). Private bucket; storage-only
# access keys from Supabase (Storage > S3 configuration), set only as encrypted hosting env vars.
# STORAGE_S3_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/v1/s3
# STORAGE_S3_REGION=eu-west-1
# STORAGE_S3_BUCKET=echo-media
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
